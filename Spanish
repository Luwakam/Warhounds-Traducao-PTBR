  "character/agent1Character/name": "George Musona",
  "character/agent1Character/nick": "RINOCERONTE",
  "character/agent1Character/age": "40",
  "character/agent1Character/birthplace": "Maputo",
  "character/agent1Character/bio": "Ex-investigador da polícia de Maputo.<br><br>Quando a guerra estourou, ele perdeu o emprego e se tornou um dos melhores agentes da Frente Popular.<br><br> Seus contatos bem estabelecidos e observaçoes profissionais permitiram-lhe coletar informaçoes únicas.<br><br>Ele despreza profundamente Da'amat, que ele considera um grupo criminoso organizado.",
  "character/agent1Character/bio_full_01": "Ex-investigador da polícia de Maputo.",
  "character/agent1Character/bio_full_02": "Quando a guerra estourou, ele perdeu o emprego e se tornou um dos melhores agentes da Frente Popular.",
  "character/agent1Character/bio_full_03": "Seus contatos bem estabelecidos e observaçoes profissionais permitiram-lhe reunir informaçoes únicas.",
  "character/agent1Character/bio_full_04": "Ele despreza profundamente o Da'amat, que considera um grupo criminoso organizado.",
  "character/agent2Character/name": "Tabani Lunga",
  "character/agent2Character/nick": "BURRO",
  "character/agent2Character/age": "43",
  "character/agent2Character/birthplace": "Harare",
  "character/agent2Character/bio": "Em sua época, ele vendia verduras na rua.<br><br>Ele era um homem de família exemplar, um marido fiel e pai de três filhas.<br><br>No dia do ataque a Harare, ele perdeu tudo o que amava.<br><br>O desejo de vingança o levou à Frente Popular e fez dele um dos lutadores mais desesperados contra o tirania de Da'amat.",
  "character/agent2Character/bio_full_01": "Antigamente, ele vendia verduras na rua.",
  "character/agent2Character/bio_full_02": "Ele era um homem de família exemplar, marido fiel e pai de três filhas.",
  "character/agent2Character/bio_full_03": "No dia do ataque a Harare, ele perdeu tudo o que amava.",
  "character/agent2Character/bio_full_04": "O desejo de vingança levou-o à Frente Popular e fez dele um dos lutadores mais desesperados contra a tirania de Da'amat.",
  "character/agent3Character/name": "Hama Dzingai",
  "character/agent3Character/nick": "PROFESSOR",
  "character/agent3Character/age": "31",
  "character/agent3Character/birthplace": "Quelimane",
  "character/agent3Character/bio": "Antes da guerra, ele trabalhava como professor em uma vila perto de Quelimane.<br><br>Ele nunca pensou que um dia pegaria em armas.<br><br>Quando Da'amat transformou sua escola em um quartel, ele nao teve escolha a nao ser se juntar à Frente Popular.<br><br>Sua mente ágil e cautela racional fizeram dele um dos melhores agentes de Kanindo.",
  "character/agent3Character/bio_full_01": "Antes da guerra, trabalhou como professor numa aldeia perto de Quelimane.",
  "character/agent3Character/bio_full_02": "Ele nunca pensou que um dia pegaria em armas.",
  "character/agent3Character/bio_full_03": "Quando Da'amat transformou a sua escola num quartel, nao teve outra escolha senao juntar-se à Frente Popular.",
  "character/agent3Character/bio_full_04": "Sua mente ágil e cautela racional fizeram dele um dos melhores agentes de Kanindo.",
  "character/vip1Character/name": "Alec Mutizwa",
  "character/vip1Character/nick": "TROVAO",
  "character/vip1Character/age": "51",
  "character/vip1Character/birthplace": "Bulawayo",
  "character/vip1Character/bio": "Ativista político de esquerda e rival apaixonado de Da'amat.<br><br>Ele nunca parou de lutar contra Da'amat ou de convocar seus compatriotas para se juntarem à luta.<br><br>Surpreendentemente, ele conseguiu sobreviver ao cativeiro. É provável que os terroristas esperassem quebrar seu espírito e usá-lo em seu próprio benefício.<br><br>Mas foi tudo em vao.",
  "character/vip1Character/bio_full_01": "Ativista político de esquerda e rival apaixonado de Da'amat.",
  "character/vip1Character/bio_full_02": "Ele nunca parou de lutar contra Da'amat ou de convocar seus compatriotas para se juntarem à luta.",
  "character/vip1Character/bio_full_03": "Surpreendentemente, ele conseguiu sobreviver ao cativeiro. É provável que os terroristas esperassem quebrar o seu espírito e usá-lo em seu próprio benefício.",
  "character/vip1Character/bio_full_04": "Mas foi tudo em vao.",
  "character/vip3Character/name": "Jimmy Mushekwi",
  "character/vip3Character/nick": "COBRA",
  "character/vip3Character/age": "27",
  "character/vip3Character/birthplace": "Xai Xai",
  "character/vip3Character/bio": "Antes da guerra, ele trabalhou como motorista de ônibus.<br><br>Ele se juntou às forças de resistência desde os primeiros dias da batalha contra Da'amat.<br><br>Ele liderou um grupo clandestino que realizou atos de sabotagem atrás das linhas inimigas.<br><br>Ele foi capturado pelos militantes durante uma dessas operaçoes.",
  "character/vip3Character/bio_full_01": "Antes da guerra, ele trabalhava como motorista de ônibus.",
  "character/vip3Character/bio_full_02": "Ele se juntou às forças de resistência desde os primeiros dias das batalhas contra o Da'amat.",
  "character/vip3Character/bio_full_03": "Ele liderou um grupo clandestino que realizou atos de sabotagem atrás das linhas inimigas.",
  "character/vip3Character/bio_full_04": "Ele foi capturado pelos militantes durante uma dessas operaçoes.",
  "character/vip2Character/name": "Tendayi Chigowa",
  "character/vip2Character/nick": "CHANGAA",
  "character/vip2Character/age": "40",
  "character/vip2Character/birthplace": "Lusaca",
  "character/vip2Character/bio": "O discreto proprietário de um pequeno bar nos arredores de Lusaka.<br><br>Durante muito tempo foi um contacto inestimável para os pelotoes de guerrilha da Frente.<br><br>Depois de ser denunciado pelos seus vizinhos, os militantes capturaram-no e torturaram-no.<br><br>Ele afirma que ele nao deu um único nome da rede clandestina.",
  "character/vip2Character/bio_full_01": "O discreto dono de um pequeno bar nos arredores de Lusaka.",
  "character/vip2Character/bio_full_02": "Durante muito tempo foi um contacto inestimável para os pelotoes de guerrilha da Frente.",
  "character/vip2Character/bio_full_03": "Após ser denunciado pelos vizinhos, os militantes o capturaram e torturaram.",
  "character/vip2Character/bio_full_04": "Ele afirma nao ter dado um único nome da rede clandestina.",
  "character/front_soldierCharacter/name": "Rebelde",
  "character/front_soldierCharacter/nick": "REBELDE",
  "character/front_soldierCharacter/bio": "Os rebeldes da Frente Popular sao um grupo diversificado. Você pode conhecer ex-soldados e pessoas que nunca pegaram em armas antes da guerra: estudantes, comerciantes e outros moradores da cidade. Eles estao todos unidos pelo seu ódio pelo Da'amat... e pela sua falta de disciplina.",
  "character/front_soldier2Character/name": "Rebelde",
  "character/front_soldier2Character/nick": "KENI OLUMO",
  "character/front_soldier2Character/bio": "Os rebeldes da Frente Popular sao um grupo diversificado. Você pode conhecer ex-soldados e pessoas que nunca pegaram em armas antes da guerra: estudantes, comerciantes e outros moradores da cidade. Eles estao todos unidos pelo seu ódio pelo Da'amat... e pela sua falta de disciplina.",
