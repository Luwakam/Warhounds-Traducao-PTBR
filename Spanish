  "character/droneAssaultCharacter/name": "drone de combate",
  "character/droneAssaultCharacter/nick": "GUARDA-FLORESTAL",
  "character/droneAssaultCharacter/bio": "Um drone pequeno e ágil projetado para apoiar unidades de assalto em combate urbano. Apesar do tamanho, o Ranger possui uma armadura decente e está até equipado com uma metralhadora em miniatura. Ao manobrar, ele pode abrir caminho através do fogo inimigo, atacar o flanco do oponente e neutralizá-lo, mesmo ao custo de sua própria vida.",
  "character/droneAssaultCharacter/bio_full_01": "Um drone pequeno e ágil projetado para apoiar unidades de assalto em combate urbano.",
  "character/droneAssaultCharacter/bio_full_02": "Apesar do tamanho, o Ranger possui uma armadura decente e está até equipado com uma metralhadora em miniatura.",
  "character/droneAssaultCharacter/bio_full_03": "Ao manobrar, ele pode abrir caminho através do fogo inimigo, atacar o flanco do oponente e neutralizá-lo, mesmo ao custo de sua própria vida.",
  "character/droneAssaultCharacter/bio_full_04": "Mesmo ao custo de sua própria “vida”.",
  "character/droneMedicalCharacter/name": "drone médico",
  "character/droneMedicalCharacter/nick": "ROUXINOL",
  "character/droneMedicalCharacter/bio": "Nightingale foi desenvolvido pela RAIT para prestar atendimento médico de emergência nas condiçoes mais difíceis, onde um médico humano nao conseguiria chegar a tempo: em expediçoes geológicas, estaçoes meteorológicas ou em combate. O corajoso pequeno Nightingale pode voar através de fogo cruzado intenso para alcançar um soldado ferido e salvar sua vida estancando o sangramento e injetando nele uma droga estabilizadora.",
  "character/droneMedicalCharacter/bio_full_01": "Nightingale foi desenvolvido pela RAIT para prestar atendimento médico de emergência nas condiçoes mais difíceis, onde um médico humano nao conseguiria chegar a tempo: em expediçoes geológicas, estaçoes meteorológicas ou em combate.",
  "character/droneMedicalCharacter/bio_full_02": "O corajoso pequeno Nightingale pode voar através de fogo cruzado intenso para alcançar um soldado ferido e salvar sua vida estancando o sangramento e injetando nele uma droga estabilizadora.",
  "character/droneMedicalCharacter/bio_full_03": "",
  "character/droneMedicalCharacter/bio_full_04": "",
  "character/droneMedicalT2Character/name": "drone médico",
  "character/droneMedicalT2Character/nick": "TERESA",
  "character/droneMedicalT2Character/bio": "Uma versao avançada do drone Nightingale amplamente distribuído. Possui maior velocidade e capacidade de manobra, bem como um modo de mira inteligente: Teresa avalia profissionalmente qual parte do corpo do inimigo será atingida de forma mais eficaz por um taser.",
  "character/droneMedicalT2Character/bio_full_01": "Uma versao avançada do drone Nightingale amplamente distribuído.",
  "character/droneMedicalT2Character/bio_full_02": "Possui maior velocidade e manobrabilidade, além de modo de mira inteligente: Teresa avalia como uma profissional qual parte do corpo do inimigo ficará mais vulnerável aos impactos de um taser.",
  "character/droneMedicalT2Character/bio_full_03": "",
  "character/droneMedicalT2Character/bio_full_04": "",
  "character/droneAssaultT2Character/name": "drone de combate",
  "character/droneAssaultT2Character/nick": "CAÇADOR",
  "character/droneAssaultT2Character/bio": "O modelo de drone de combate mais avançado. Graças à utilizaçao de modernos materiais poliméricos, os engenheiros da RAIT conseguiram dotar o drone de uma blindagem muito resistente e, ao mesmo tempo, reduzir o seu peso, o que teve um efeito positivo na sua velocidade. Hunter, é claro, nao pode substituir um soldado de verdade, mas serve de grande ajuda.",
  "character/droneAssaultT2Character/bio_full_01": "O modelo de drone de combate mais avançado.",
  "character/droneAssaultT2Character/bio_full_02": "Graças à utilizaçao de modernos materiais poliméricos, os engenheiros da RAIT conseguiram dotar o drone de uma blindagem muito resistente e, ao mesmo tempo, reduzir o seu peso, o que teve um efeito positivo na sua velocidade.",
